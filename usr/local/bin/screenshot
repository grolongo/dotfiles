#!/usr/bin/env bash
set -e
set -u
set -o pipefail
IFS=$'\n\t'

readonly prog="${0##*/}"
folder="${HOME}/Pictures/screenshots/"

usage() {
    cat << EOF
Usage: ${prog} [options]

Take a screenshot with grim and save it to a folder
(default: ${folder}).
If no capture option is given, take a screenshot of the whole screen.

Options:
  -f, --fullscreen      Take a screenshot of the whole screen.
  -s, --selection       Select a region with slurp before capturing.
  -d, --directory=DIR   Save the screenshot in DIR (created if missing).
  -h, --help            Show this help and exit.
EOF
    exit 0
}

usage_error() {
    {
        printf '%s: %s\n' "${prog}" "${1}"
        printf 'Usage: %s %s %s %s\n' \
               "${prog}" \
               '[-f|--fullscreen]' \
               '[-s|--selection]' \
               '[-d|--directory DIR]'
        printf "Try '%s --help' for more information.\n" "${prog}"
    }  >&2
    exit 1
}

capture() {
    mkdir -p "${folder}"
    file="${folder}/$(date +'screenshot_%Y-%m-%d_%H-%M-%S.png')"
    grim "$@" "${file}"
}

parse_args() {
    while (( $# > 0 )); do
        case "${1}" in
            -h | --help)
                usage
                ;;
            -f | --fullscreen)
                mode="fullscreen"
                shift
                ;;
            -s | --selection)
                mode="selection"
                shift
                ;;
            -d | --directory)
                if (( $# < 2 )); then
                    usage_error "option '${1}' requires a path to a directory"
                fi
                folder="${2}"
                shift 2
                ;;
            --directory=*)
                folder="${1#*=}"
                shift
                ;;
            -*)
                usage_error "unknown option '${1}'"
                ;;
            *)
                usage_error "unknown argument '${1}'"
                ;;
        esac
    done

    if [[ -z "${folder}" ]]; then
        usage_error "the directory cannot be empty"
    fi

    folder="${folder/#\~/${HOME}}"
}

dispatch() {
    local region

    case "${mode:-fullscreen}" in
        fullscreen)
            capture
            ;;
        selection)
            region="$(slurp)"
            capture -g "${region}"
            ;;
    esac
}

notification() {
    notify-send "Screenshot" \
                "Image saved in ${folder}" \
                --icon="${file}"
}

main() {
    parse_args "$@"
    dispatch
    notification
}

main "$@"
