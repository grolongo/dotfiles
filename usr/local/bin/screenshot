#!/usr/bin/env bash
set -e
set -u
set -o pipefail
IFS=$'\n\t'

readonly prog="${0##*/}"
readonly folder="${HOME}/Downloads"

usage() {
    cat << EOF
Usage: ${prog} [option]

Take a screenshot with grim and save it to ${folder}
If no argument is given, take a screenshot of the whole screen.

Options:
  -f, --fullscreen  Take a screenshot of the whole screen.
  -s, --selection   Select a region with slurp before capturing.
  -h, --help        Show this help and exit.
EOF
    exit 0
}

usage_error() {
    {
        printf '%s: %s\n' "${prog}" "${1}"
        printf 'Usage: %s %s %s %s\n' \
               "${prog}" \
               '[-f|--fullscreen]' \
               '[-s|--selection]' \
               '[-h|--help]'
        printf "Try '%s --help' for more information.\n" "${prog}"
    }  >&2
    exit 1
}

capture() {
    mkdir -p "${folder}"
    file="${folder}/$(date +'screenshot_%Y-%m-%d_%H-%M-%S.png')"
    grim "$@" "${file}"
}

run_command() {
    local region

    case "${1:-}" in
        "" | -f | --fullscreen)
            capture
            ;;
        -s | --selection)
            region="$(slurp)"
            capture -g "${region}"
            ;;
        -h | --help)
            usage
            ;;
        *)
            usage_error "unrecognized option '${1}'"
            ;;
    esac
}

notification() {
    notify-send "Screenshot" \
                "Image saved in ${folder}" \
                --icon="${file}"
}

main() {
    if (( $# > 1 )); then
        usage_error "too many arguments"
    else
        run_command "$@"
        notification
    fi
}

main "$@"
