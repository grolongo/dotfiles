#!/usr/bin/env bash
set -e
set -u
set -o pipefail
IFS=$'\n\t'

folder="${HOME}/Downloads"
file="$folder/$(date +'screenshot_%Y-%m-%d_%H-%M-%S.png')"

usage() {
    cat << EOF
Usage: ${0##*/} [option]

Take a screenshot with grim and save it to ${folder}
If no argument is given, take a screenshot of the whole screen.

Options:
  -f, --fullscreen  Take a screenshot of the whole screen.
  -s, --selection   Select a region with slurp before capturing.
  -h, --help        Show this help and exit.
EOF
}

usage_error() {
    {
        printf "%s: unrecognized option '%s'\n" "${0##*/}" "${1:-}"
        printf "Try '%s --help' for more information.\n" "${0##*/}"
    }  >&2
    exit 1
}

screenshot() {
    case "${1:-}" in
        "" | -f | --fullscreen)
            grim "${file}"
            ;;
        -s | --selection)
            grim -g "$(slurp)" "${file}"
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            usage_error "${1}"
            ;;
    esac
}

notification() {
    notify-send "Screenshot" \
                "Image saved in ${folder}" \
                --icon="${file}"
}

main() {
    if (( $# > 1 )); then
        usage_error "${2}"
    else
        mkdir -p "${folder}"
        screenshot "$@"
        notification
    fi
}

main "$@"
