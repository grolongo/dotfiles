#!/usr/bin/env bash
set -e
set -u
set -o pipefail
IFS=$'\n\t'

readonly prog="${0##*/}"

usage() {
    cat << EOF
Usage: ${prog} <filename>

Automatically detects a file's archive format based on its extension and
extracts it using the appropriate system tool.

Supported formats:
  tar, tar.bz2, tbz2, tar.gz, tgz, tar.xz, tar.zst, tar.z, lzma, bz2, gz, xz,
  rar, zip, pax.z, z, 7z, exe (CAB), pax, deb, rpm, dmg (mounts the image)

Options:
  -h, --help  Show this help and exit.
EOF
    exit 0
}

usage_error() {
    {
        printf '%s: %s\n' "${prog}" "${1}"
        printf "Usage: %s <filename>\n" "${prog}"
        printf "Try '%s --help' for more information.\n" "${prog}"
    } >&2
    exit 1
}

filecheck() {
    if [[ ! -f "${1}" ]]; then
        printf "%s: file does not exist '%s' \n" "${prog}" "${1}" >&2
        exit 1
    fi
}

dispatch() {
    local file lower
    file="${1}"
    lower="$(printf '%s' "${file}" | tr '[:upper:]' '[:lower:]')"

    case "${lower}" in
        *.tar)            tar -xvf "${file}"                                       ;;
        *.tar.bz2|*.tbz2) tar -xvjf "${file}"                                      ;;
        *.tar.gz|*.tgz)   tar -xvzf "${file}"                                      ;;
        *.tar.xz)         tar -xvJf "${file}"                                      ;;
        *.tar.zst)        tar --zstd -xvf "${file}"                                ;;
        *.tar.z)          uncompress -c "${file}" | tar -xvf -                     ;;
        *.lzma)           unlzma "${file}"                                         ;;
        *.bz2)            bunzip2 "${file}"                                        ;;
        *.gz)             gunzip "${file}"                                         ;;
        *.xz)             unxz "${file}"                                           ;;
        *.rar)            unrar x -ad "${file}"                                    ;;
        *.zip)            unzip "${file}"                                          ;;
        *.pax.z)          uncompress "${file}" --stdout | pax -r                   ;;
        *.z)              uncompress "${file}"                                     ;;
        *.7z)             7z x "${file}"                                           ;;
        *.exe)            cabextract "${file}"                                     ;;
        *.dmg)            hdiutil attach "${file}"                                 ;;
        *.pax)            pax -r < "${file}"                                       ;;
        *.deb)            ar x "${file}"                                           ;;
        *.rpm)            rpm2cpio "${file}" | cpio -idmv                          ;;
        *)
            printf "%s: unknown archive method '%s' \n" "${prog}" "${file}" >&2
            exit 1
            ;;
    esac
}

main() {
    if (( $# > 1 )); then
        usage_error "too many arguments"
    fi

    case "${1:-}" in
        -h | --help)
            usage
            ;;
        "")
            usage_error "missing file"
            ;;
        *)
            filecheck "${1}"
            dispatch "${1}"
            ;;
    esac
}

main "$@"
