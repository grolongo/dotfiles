#!/usr/bin/env bash
set -e
set -u
set -o pipefail
IFS=$'\n\t'

battery_path="/sys/class/power_supply/BAT0"
battery_status=$(< "${battery_path}/status")
battery_percentage=$(< "${battery_path}/capacity")

battery_check() {
    low_battery=0
    if [[ "${battery_status}" == "Not charging" ||
              "${battery_status}" == "Discharging" ]] \
                  && ((battery_percentage < 15)); then
        low_battery=1
    fi
}

notification() {
    if (( low_battery == 1 )); then
        notify-send "LOW BATTERY" \
                    "${battery_percentage}% remaining" \
                    --icon=/usr/share/icons/Adwaita/symbolic/status/battery-level-0-symbolic.svg \
                    --hint=string:x-dunst-stack-tag:battery_notif \
                    --urgency=critical
    fi
}

main() {
    battery_check
    notification
}

main
