#!/usr/bin/env bash
set -e
set -u
set -o pipefail
IFS=$'\n\t'

usage() {
    cat << EOF
Usage: ${0##*/} [option] command

Wrapper around brightnessctl using notify-send as an OSD feedback.

Commands:
  up    Increase brightness.
  down  Decrease brightness.

Options:
  -h, --help  Show this help and exit.
EOF
}

usage_error() {
    {
        printf "%s: invalid argument '%s'\n" "${0##*/}" "${1:-}"
        printf "Try '%s --help' for more information.\n" "${0##*/}"
    }  >&2
    exit 1
}

get_brightness() {
    local brightness_current brightness_max
    brightness_current=$(brightnessctl get)
    brightness_max=$(brightnessctl max)
    awk -v current="${brightness_current}" -v max="${brightness_max}" \
        'BEGIN { printf "%.0f", current/max*100 }'
}

notification() {
    local brightness
    brightness=$(get_brightness)
    notify-send --icon=/usr/share/icons/Adwaita/symbolic/status/display-brightness-symbolic.svg \
                --hint=string:x-dunst-stack-tag:brightness_notification \
                --hint=int:value:"${brightness}" "Brightness: ${brightness}%" \
                --urgency=low
}

set_brightness() {
    case "${1}" in
        up)
            brightnessctl -q set +10%
            ;;
        down)
            brightnessctl -q set 10%-
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            usage_error "${1}"
            ;;
    esac
}

main() {
    if (( $# > 1 )); then
        usage_error "${2}"
    else
        set_brightness "${1}"
        notification
    fi
}

main "$@"
