#!/usr/bin/env bash
set -e
set -u
set -o pipefail
IFS=$'\n\t'

readonly prog="${0##*/}"
readonly step=10

usage() {
    cat << EOF
Usage: ${prog} <command>

Wrapper around brightnessctl using notify-send as an OSD feedback.

Commands:
  up    Increase brightness by ${step}%.
  down  Decrease brightness by ${step}%.

Options:
  -h, --help  Show this help and exit.
EOF
    exit 0
}

usage_error() {
    {
        printf '%s: %s\n' "${prog}" "${1}"
        printf 'Usage: %s <up|down>\n' "${prog}"
        printf "Try '%s --help' for more information.\n" "${prog}"
    } >&2
    exit 1
}

run_command() {
    case "${1:-}" in
        up)
            brightnessctl -q set "+${step}%"
            ;;
        down)
            brightnessctl -q set "${step}%-"
            ;;
        -h | --help)
            usage
            ;;
        "")
            usage_error "missing command"
            ;;
        *)
            usage_error "invalid command '${1}'"
            ;;
    esac
}

get_brightness() {
    local brightness_current brightness_max
    brightness_current=$(brightnessctl get)
    brightness_max=$(brightnessctl max)
    awk -v current="${brightness_current}" -v max="${brightness_max}" \
        'BEGIN { printf "%.0f", current/max*100 }'
}

notification() {
    local brightness
    brightness=$(get_brightness)
    notify-send "Brightness: ${brightness}%" \
                --icon=/usr/share/icons/Adwaita/symbolic/status/display-brightness-symbolic.svg \
                --hint=string:x-dunst-stack-tag:brightness_notification \
                --hint=int:value:"${brightness}" \
                --urgency=low
}

main() {
    if (( $# > 1 )); then
        usage_error "too many arguments"
    fi

    run_command "${1:-}"
    notification
}

main "$@"
